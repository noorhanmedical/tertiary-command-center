# =============================================================================
# Local development environment — copy this to `.env` to run locally.
# Points at a Postgres instance running via Docker (docker-compose.yml).
# NO AWS credentials needed. NO access to production data.
# =============================================================================

NODE_ENV=development
PORT=5000

# Local Postgres (started by `docker compose up -d`)
DATABASE_URL=postgres://plexus:plexusdev@localhost:5432/plexus

# Any random string works locally — sessions are just local
SESSION_SECRET=local-dev-secret-change-in-prod

# Use google_drive for dev (no S3 needed — document upload features are limited locally)
STORAGE_PROVIDER=google_drive

# Optional: add your OpenAI key if you need AI note-generation features locally
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# Feature flags
USE_PATIENT_DIRECTORY_ACTIVATION=1
